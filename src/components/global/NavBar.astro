---
import Link from "../elements/Link.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const nav = [
    { title: "/inicio", path: "" },
    { title: "/proyectos", path: "/projects" },
    { title: "/sobre-mí", path: "/about" },
    { title: "/contactos", path: "/contact" },
];
---

<nav class="bg-base-900 flex flex-row flex-wrap sticky top-0">
    {
        nav.map((navLink) => {
            const route = `${base}${navLink.path}` || "/";
            const href = route === "/" ? "/" : `${route}/`;

            const isActive = navLink.path === ""
                ? pathname === route
                : pathname === route || pathname.startsWith(`${route}/`);

            return (
                <Link
                    variant="nav"
                    href={href}
                    text={navLink.title}
                    aria-current={isActive ? "page" : undefined}
                    class={isActive ? "bg-base-950 border-t-2 border-base-900" : ""}
                />
            );
        })
    }
</nav>